import threading
import time
import random
from pynput import mouse

# 全局运行标志
running = False

# 控制器
mouse_ctrl = mouse.Controller()


def mouse_click_loop():
    """鼠标自动点击循环"""
    global running
    while running:
        # 随机间隔 0.6 + 0.05 * random(0~5)
        delay = 0.6 + 0.05 * random.randint(0, 5)
        time.sleep(delay)
        if not running:
            break
        mouse_ctrl.click(mouse.Button.left, 1)
        print(f"[鼠标] 点击，间隔 {delay:.2f} 秒")



def on_press_f8(key):
    """热键回调：按 F8 切换运行状态"""
    global running
    try:
        if key == keyboard.Key.f8:
            running = not running
            print("\n>>> 运行状态：", "启动" if running else "停止")
            if running:
                
                t1 = threading.Thread(target=mouse_click_loop, daemon=True)
               
                t1.start()
  
    except Exception as e:
        print(f"热键回调错误：{e}")

if __name__ == "__main__":
    # 启动键盘全局监听器
    listener = keyboard.Listener(on_press=on_press_f8)
    listener.start()
    print("脚本已运行，按 F8 启动/停止自动操作")
    //listener.join()  # 保持主线程运行//
